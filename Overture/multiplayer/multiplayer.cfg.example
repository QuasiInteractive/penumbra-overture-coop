# Copy to multiplayer.cfg next to penumbra.exe / working dir.
# host=1        — auto-listen UDP (uses port=)
# join=HOST:PRT — auto-connect once a map is loaded
# port=7777    — default listen / F10 localhost join port
#
# Remote-player body mesh — .dae files (+ their <name>_<clip>.dae siblings) in:
#   multiplayer/models/malik.dae
#   multiplayer/models/phillip.dae
# PlayerID 1 (host) uses the first mesh, ID 2 the second — same order everywhere.
#
# v11: the wire carries the sender's FEET height and the shipped meshes have
# their origin at the feet, so no grounding offset is needed any more.
# ghost_body_y / ghost_body_y_crouch are now extra offsets FROM THE FEET
# (default 0). Values below -0.9 are treated as the old camera-relative
# numbers and converted (logged) — delete them from an old cfg.

host=0
# ---- Username (v13) ----------------------------------------------------------
# player_name=  — the name the other players see: over each friend's head,
#                 in the inventory party list and in the top-left party panel
#                 ("<name> joined / left / died / respawned"). Printable ASCII,
#                 spaces OK, 24 characters max; anything else is stripped.
#                 Leave it empty (or out) and the Multiplayer menu asks for it
#                 the first time and writes it here ("Change name" edits it;
#                 every other line of this file is kept). Friends without a
#                 name show as "Player <id>".
player_name=
# server_name=  — shown in the LAN server browser (spaces OK, 31 chars max).
#                 Empty / not set = "<player_name>'s game" ("Penumbra Server"
#                 when there is no player_name either).
# max_players=  — advertised in discovery pongs AND enforced at connect
#                 (2..31, default 4): the (max_players)th player and later
#                 are refused with "server full".
# server_name=Penumbra Server
max_players=4
port=7777

# ---- Passwords (v15) --------------------------------------------------------
# server_password= — what a HOST demands. Empty (or out) = open server: anyone
#                   with the address can join. Set one before forwarding the
#                   game port to the internet or listing the server in a
#                   public lobby. Printable ASCII, spaces OK, 48 chars max.
#                   Never sent in the clear: the guest answers a per-connection
#                   challenge with a digest of it (README "Security").
# join_password=   — what a GUEST sends when joining (the join screen / lobby
#                   can set it too). Wrong or missing = "Host REFUSED: wrong
#                   password" on the join screen.
server_password=
join_password=
# join=127.0.0.1:7777
# Host (id 1) appears as malik.dae to others; client (id 2) phillip — more peers rotate.
ghost_models=malik.dae,phillip.dae
# Alternative: single mesh — ghost_model=foo.dae
# ghost_body_y=0
# ghost_body_y_crouch=0

# Per-mesh grounding overrides (CSV, indexed like ghost_models — a rig whose
# origin is NOT at its feet). Overrides ghost_body_y/_crouch per mesh.
# More negative = mesh lower.
# ghost_body_ys=0,0
# ghost_body_ys_crouch=0,0

# ---- Co-op death (v12) ------------------------------------------------------
# Every player's health rides on the 30 Hz state packet (protocol v12): a
# bar above each friend's head (within 25 m) and a "Party" list in the
# inventory show it, and the host's enemies stop attacking a dead guest.
# coop_respawn=1 — when you die in a live session while at least one other
#                  party member is still alive, the death fade plays as usual
#                  but the death menu does NOT appear: ~3 s later you come
#                  back with 40 health next to the nearest living member
#                  (hpl.log says who). If everybody is dead you get the normal
#                  death menu. 0 = vanilla death menu online too.
coop_respawn=1

# ---- Ghost animation (v11) ------------------------------------------------
# ghost_interp_ms=100   — render remote players this far behind their newest
#                         state (3 packets at 30 Hz). Lower = snappier, higher
#                         = smoother on a jittery link. 0..250.
# ghost_turn_rate=720   — body yaw follows the remote view yaw at most this
#                         fast (deg/s). 30..3600.
# ghost_gait_<slot>=    — metres per second the clip covers at playback
#                         speed 1.0; the ghost plays each locomotion clip at
#                         (real speed / gait), clamped 0.6..1.8, so the feet
#                         stop sliding. Defaults are measured from the shipped
#                         phillip clips (each model's <name>_clips.json is read
#                         when present). Slots: walk, run, crouch_walk,
#                         walk_back, strafe_walk (both sides), strafe_run (both
#                         sides); an exact clip name (strafe_walk_l) overrides
#                         one clip.
# ghost_gait_walk=1.28
# ghost_gait_run=1.92
# ghost_gait_crouch_walk=0.76
# ghost_gait_walk_back=0.72
# ghost_gait_strafe_walk=0.65
# ghost_gait_strafe_run=1.97
# ghost_anim_trace=0    — 1 logs every clip change and a 5-second state trace
#                         per ghost to hpl.log (synchronous disk writes: leave
#                         off in real sessions).

# ---- Ghost preview (offline animation check) -------------------------------
# ghost_preview=1 puts a LOCAL ghost 2 m in front of you, facing you, as soon
# as a map is up (no session needed). It is driven through the same path a
# network ghost is. Keys while it exists:
#   F6 / F7 — next / previous clip (all loaded clips, one-shots replay)
#   F8      — toggle crouch stance (plays the stand<->crouch transitions)
#   F2      — treadmill off / walk / run: walks a 1 m circle at the real
#             game.cfg speeds so gait scaling + clip selection can be judged
# One hpl.log line per change.
# ghost_preview=0
# ghost_preview_model=0 — which ghost_models entry the preview uses (0-based)

# ---- Windowed test instances (read by Init.cpp at startup) ----
# force_windowed=1 overrides the Documents settings.cfg FullScreen setting for
# THIS install only; window_width/height set the size and window_x/window_y
# the top-left corner, so two installs on one PC can sit side by side:
#   redist       (host):  force_windowed=1 window_width=960 window_height=540 window_x=0   window_y=0
#   redist_guest (guest): force_windowed=1 window_width=960 window_height=540 window_x=960 window_y=0
# force_windowed=0
# window_width=960
# window_height=540
# window_x=0
# window_y=0
